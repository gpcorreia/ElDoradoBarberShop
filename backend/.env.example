NODE_ENV=development
PORT=1000
TRUST_PROXY=false
APP_ORIGIN=http://localhost:1000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-backend-secret-key

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
ADMIN_SESSION_MAX_AGE_MS=31536000000

JWT_SECRET_KEY=replace-with-a-random-secret-containing-at-least-32-characters
JWT_ISSUER=eldorado-barbershop
JWT_AUDIENCE=eldorado-admin

GMAIL_USER=your-email@gmail.com
# Recomendado no Render gratuito: Gmail API por HTTPS.
GMAIL_API_CLIENT_ID=your-google-oauth-client-id
GMAIL_API_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_API_REFRESH_TOKEN=your-google-oauth-refresh-token
# Alternativa apenas onde SMTP 465/587 seja permitido.
# GMAIL_APP_PASSWORD=your-google-app-password
# Endereço da barbearia que recebe as respostas dos clientes.
CONTACT_TO_EMAIL=destination@example.com

# Confirmações de marcação por SMS através do BulkGate.
BULKGATE_APPLICATION_ID=your-bulkgate-application-id
BULKGATE_APPLICATION_TOKEN=your-bulkgate-application-token
BULKGATE_COUNTRY=pt
BULKGATE_REMINDER_HOURS=24
# gSystem funciona sem um remetente personalizado. Para gText/gProfile, configurar também o respetivo valor.
BULKGATE_SENDER_ID=gSystem
# BULKGATE_SENDER_ID_VALUE=ElDorado
# Apenas para testes locais; nunca usar um número de cliente.
# TEST_SMS_PHONE=+351900000000

SMOKE_BASE_URL=http://localhost:1000
