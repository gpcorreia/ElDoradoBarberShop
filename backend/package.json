{
  "name": "backend",
  "version": "1.0.0",
  "description": "API e servidor web da ElDorado Barbershop",
  "repository": {
    "type": "git",
    "url": "https://github.com/gpcorreia"
  },
  "license": "ISC",
  "author": "GoncaloCorreia",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:css && tsc",
    "build:css": "tailwindcss -c tailwind.config.js -i ../public/css/tailwind.input.css -o ../public/css/tailwind.generated.css --minify",
    "build:server": "tsc",
    "start": "node dist/server.js",
    "dev": "npm run build:css && nodemon server.ts",
    "start:dev": "ts-node server.ts",
    "type-check": "tsc --noEmit",
    "check:seo": "node scripts/check-seo.js",
    "audit:prod": "npm audit --omit=dev",
    "generate:admin-credentials": "node scripts/generate-admin-credentials.js",
    "test:sms": "node scripts/test-bulkgate.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.11",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
